{
  "name": "uselessfenixutils",
  "version-string": "1.0.0",
  "description": "Here should be description",
  "homepage": "https://github.com/fenix31415",
  "license": "MIT",
  "dependencies": [
    "boost-atomic",
    "boost-stl-interfaces",
    "glm",
		"jsoncpp",
		"magic-enum",
    "spdlog",
    "xbyak"
  ],
  "features": {
    "imgui": {
      "description": "Build with ImGui utilities",
      "dependencies": [
        {
          "name": "imgui",
          "platform": "windows",
          "features": ["dx11-binding", "win32-binding"],
          "default-features": false
        }
      ]
    },
    "support-se": {
      "description": "Build platform for Skyrim SE.",
      "dependencies": [
        {
          "name": "commonlib",
          "platform": "windows"
        }
      ]
    },
    "support-ae": {
      "description": "Build platform for Skyrim AE.",
      "dependencies": [
        {
          "name": "commonlib",
          "platform": "windows",
          "default-features": false,
          "features": ["support-ae"]
        }
      ]
    }
  }
}
