@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(CommonLibSSE CONFIG REQUIRED)
find_dependency(spdlog CONFIG REQUIRED)
find_dependency(jsoncpp CONFIG REQUIRED)
find_dependency(magic_enum CONFIG REQUIRED)

if(@WITH_IMGUI@)
    find_dependency(imgui CONFIG REQUIRED)
endif()

# Подключение целей
include("${CMAKE_CURRENT_LIST_DIR}/UselessFenixUtils-targets.cmake")

if(@WITH_DRAWING@)
    target_compile_definitions(UselessFenixUtils::UselessFenixUtils INTERFACE USELESS_FENIX_UTILS_WITH_DRAWING=1)
endif()

if(@WITH_IMGUI@)
    target_compile_definitions(UselessFenixUtils::UselessFenixUtils INTERFACE USELESS_FENIX_UTILS_WITH_IMGUI=1)
endif()

check_required_components(UselessFenixUtils)
